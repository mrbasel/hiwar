[Unit]
Description=Cloudflare Tunnel to the rawi API
After=network-online.target
Wants=network-online.target

[Service]
User=cloudflared
# TUNNEL_TOKEN; the tunnel's routes are set in Cloudflare (ansible/scripts/tunnel.sh).
EnvironmentFile=/etc/cloudflared/token.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
