# Managed by ansible/app.yml; secrets come from host_vars/rawi/vault.yml.
NODE_ENV=production
HOST=127.0.0.1
PORT={{ app_port }}
# cloudflared passes on the client's IP, so per-IP rate limits work.
TRUST_PROXY=1
DB_PATH=/srv/rawi/data/current/serve.db
PUBLIC_DIR=/srv/rawi/current/public
QUERY_EMBEDDER=cloudflare
CF_ACCOUNT_ID={{ vault_cf_account_id }}
CF_API_TOKEN={{ vault_cf_api_token }}
